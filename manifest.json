{
  "manifest_version": 3,
  "name": "JSner - Endpoint Extractor",
  "version": "3.0.1",
  "description": "Advanced endpoint scanner with pscon bridge support. Extract and verify API endpoints, GraphQL queries, and more from any website.",
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "tabs",
    "webRequest",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jsner@ciatech.network",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-scanner.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["results.html", "results.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "JSner - Extract Endpoints"
  }
}
